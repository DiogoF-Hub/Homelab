<!--
  wazuh-home (manager): rules for dpkg config-file decisions.
  Append inside /var/ossec/etc/rules/local_rules.xml on the manager.
  Validate + restart:
      sudo /var/ossec/bin/wazuh-analysisd -t
      sudo systemctl restart wazuh-manager

  Source: /var/log/dpkg.log on every agent (default localfile), decoded
  by manager-dpkg-decoder.xml. decoded_as names the PARENT decoder
  (windows-date-format); the dpkg_decision field is what tells these
  lines apart from anything else starting with a timestamp.

  Rule-ID block 100600-100601 (DNS 100250-100253, modsec 100300-100303,
  fail2ban 100400-100401, maintenance 100500-100502 are taken):
    100600 (level 0): base, any conffile decision. Archived, no alert.
    100601 (level 7): decision=keep. The nightly upgrade kept a locally
                      edited config file (squid.conf, sudoers, ...) and
                      saved the package's new version as .dpkg-dist.
                      custom-discord posts it to #maintenance.
  "install" decisions (someone chose the package version by hand) stay
  at the level-0 base.
-->
<group name="dpkg,dpkg_conffile,">
  <rule id="100600" level="0">
    <decoded_as>windows-date-format</decoded_as>
    <field name="dpkg_decision">\S</field>
    <description>dpkg config file decision: $(dpkg_conffile) $(dpkg_decision)</description>
  </rule>

  <rule id="100601" level="7">
    <if_sid>100600</if_sid>
    <field name="dpkg_decision" type="pcre2">^keep$</field>
    <description>Upgrade kept the local $(dpkg_conffile); new default saved as .dpkg-dist</description>
  </rule>
</group>
