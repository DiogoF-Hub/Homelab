<!--
  wazuh-home (manager): decoder for dpkg's config-file decisions in
  /var/log/dpkg.log. Every agent already tails that file (the agent
  installer adds the localfile by default), so nothing is needed on the
  agents.

  Append to /var/ossec/etc/decoders/local_decoder.xml on the manager.
  Validate + restart:
      sudo /var/ossec/bin/wazuh-analysisd -t
      sudo systemctl restart wazuh-manager

  The line dpkg writes when a package ships a new version of a config
  file that was edited locally:
      2026-10-10 04:20:01 conffile /etc/squid/squid.conf keep
  The last word is the decision: "keep" (local file kept, the package's
  version saved as <file>.dpkg-dist; what dpkg's force-confold option does in the
  nightly update scripts) or "install" (package version installed).

  Wazuh's built-in decoders only recognise the timestamp
  (wazuh-logtest: name 'windows-date-format', no fields, no rule), so
  this hooks under that parent and pulls out the two fields. Field names
  are prefixed dpkg_ to stay clear of Wazuh's static fields.

  Paired rules: manager-dpkg-rules.xml (100600 base + 100601 keep).
-->
<decoder name="dpkg-conffile">
  <parent>windows-date-format</parent>
  <prematch offset="after_parent">^\s*conffile </prematch>
  <regex offset="after_prematch">^(\S+) (\S+)$</regex>
  <order>dpkg_conffile, dpkg_decision</order>
</decoder>
