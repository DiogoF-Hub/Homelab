      "all": [{"in": "body", "has": ":__proto__:then"}],
      "any": [{"in": "body", "re": "\\beval\\b"}]
    },
    {
      "name": "React2Shell secret dump",
      "cve": "CVE-2025-55182",
      "all": [{"in": "body", "has": ":__proto__:then"}],
      "any": [{"in": "body", "has": "/proc/self/environ"}, {"in": "body", "re": "execSync\\(['\"]env\\b"}]
    },
    {
      "name": "React2Shell probe",
