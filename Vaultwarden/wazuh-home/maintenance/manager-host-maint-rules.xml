<!--
  wazuh-home (manager): rules for the nightly maintenance report of the
  other hosts (Pi-hole VM, wazuh-home itself, edge VPS). The Vault VM keeps
  its own, richer pipeline (manager-maint-rules.xml, 100500-100502).

  Append inside /var/ossec/etc/rules/local_rules.xml on the manager.
  Validate + restart:
      sudo /var/ossec/bin/wazuh-analysisd -t
      sudo systemctl restart wazuh-manager

  Source: /var/log/maint-status.jsonl on each host, one JSON line per run
  written by that host's main.sh (localfile in host-maint.localfile.xml).
  The built-in JSON decoder extracts every field into data.*;
  event_type=host_maint is the discriminator, role = pihole | wazuh | vps.

  Rule-ID block 100510-100512 (next to the Vault VM's maintenance block):
    100510 (level 0):  base, every host_maint line. Archived, no alert.
    100511 (level 3):  maint_sev=info (status ok). Nightly heartbeat.
    100512 (level 11): maint_sev=warn (degraded | fail). Needs attention.

  The rules match maint_sev, not status: Wazuh reserves `status` as a
  static field that <field> can't match (same trap as vw_sev in
  manager-maint-rules.xml). custom-discord hooks 100511 + 100512 and posts
  to the #maintenance channel of the host's Discord category (webhook key
  maintenance-<role>).
-->
<group name="host_maint,">
  <rule id="100510" level="0">
    <decoded_as>json</decoded_as>
    <field name="event_type">host_maint</field>
    <description>Host maintenance ($(role)) [$(status)]</description>
  </rule>

  <rule id="100511" level="3">
    <if_sid>100510</if_sid>
    <field name="maint_sev" type="pcre2">^info$</field>
    <description>Maintenance run OK on $(role).</description>
  </rule>

  <rule id="100512" level="11">
    <if_sid>100510</if_sid>
    <field name="maint_sev" type="pcre2">^warn$</field>
    <description>Maintenance run $(status) on $(role), needs attention.</description>
  </rule>
</group>
